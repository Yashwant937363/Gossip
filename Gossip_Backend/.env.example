JWT_SECRET = secret
DATABASE = mongodb 
Email = enter your email here
AppPassword = enter app pasword which you get it if you enabled the 2FA. then you can create the app pasword.
CLOUDINARY_CLOUD_NAME = you will get this from cloudinary
CLOUDINARY_API_KEY = you will get this from cloudinary
CLOUDINARY_API_SECRET = you will get this from cloudinary
GROQ_API_KEY = your groq api key

# Monitoring & Grafana Cloud Loki
BACKEND_DOMAIN = your-deployed-backend.onrender.com
# BACKEND_SCHEME = https
LOKI_URL = https://logs-prod-XXX.grafana.net
LOKI_USERNAME = your_grafana_cloud_loki_user_id
LOKI_TOKEN = your_grafana_cloud_loki_token

# Load Testing Mocks (disabled by default)
MOCK_AI=false
MOCK_AI_LATENCY_MS=50
MOCK_UPLOAD=false
MOCK_UPLOAD_LATENCY_MS=50
